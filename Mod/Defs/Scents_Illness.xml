<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- La maladie sur le pion lui-meme, et non la salete qu'elle laisse.

       C'est le seul bloc de ce mod qui ne demande aucun code : RimScent lit deja les
       HediffDef d'un pion voisin - c'est meme la SEULE chose qu'il lit sur un voisin. Un
       simple modExtensions sur la maladie suffit donc, et le volet chambre de malade
       (saletes de germes) reste complementaire : l'un sent la piece, l'autre sent la
       personne. Les deux peuvent s'appliquer, le concours de dominance tranche.

       Point important : RimScent teste `other != pawn`. Un colon ne sent donc JAMAIS sa
       propre maladie, seulement celle des autres. C'est le comportement d'origine, et il
       tombe juste - on s'habitue a sa propre odeur avant toutes les autres.

       Les parasites intestinaux, les parasites musculaires et les mecanites n'ont
       volontairement aucune odeur : rien de tout cela ne se sent de l'exterieur, et leur
       en inventer une serait du bruit. -->

  <ThoughtDef Name="RimScentExtended_IllnessScentBase" Abstract="True">
    <durationDays>0.1</durationDays>
    <stackLimit>2</stackLimit>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_IllnessScentBase">
    <defName>RimScentExtended_Scent_Fever</defName>
    <stages>
      <li>
        <label>fever</label>
        <description>Sour sweat and hot breath. Somebody here is running a fever, and you can smell it before you can see it.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Plus fort que la fievre, et volontairement : une plaie infectee est l'odeur qui
       fait qu'on remarque un blesse avant de l'avoir regarde. -->
  <ThoughtDef ParentName="RimScentExtended_IllnessScentBase">
    <defName>RimScentExtended_Scent_Infection</defName>
    <stages>
      <li>
        <label>infection</label>
        <description>Pus and something turning underneath the bandage. Sweetish, and it does not belong on a living body.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
